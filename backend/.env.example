# ============================================================
# AI 模拟面试系统 - 环境配置模板
# 复制为 .env 后填写真实值；.env 不提交进 git（.gitignore 已挡）
# 本文件会进 git，任何情况下都不得写入真实密钥
# ============================================================

# ---------- 文字模型：出题 / 评分 / 追问（DeepSeek） ----------
TEXT_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TEXT_BASE_URL=https://api.deepseek.com/v1
TEXT_MODEL=deepseek-chat

# ---------- 视觉/解析模型：简历与 JD 解析（阿里云千问 MaaS，OpenAI 兼容协议） ----------
# 按官方样例：仅支持文本输出，调用时自动带 modalities=["text"]
VISION_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VISION_BASE_URL=https://cn-beijing.maas.qianwenaiapi.com/compatible-mode/v1
VISION_MODEL=qwen3.8-omni-flash

# ---------- 基础设施（compose.yaml 映射端口，避开本机 5432/6379 已占服务） ----------
DATABASE_URL=postgresql+psycopg://interview:interview_dev_pw@localhost:5433/interview
REDIS_URL=redis://localhost:6380/0

# ---------- 开发开关 ----------
# LLM_MOCK=1 时全部模型调用走本地 mock（不联网、不花钱），供测试与开发
LLM_MOCK=0

# ---------- 业务默认值（开发说明 §1.3 建议默认，验收前可调） ----------
QUESTION_COUNT=15
MAX_FOLLOWUPS_PER_QUESTION=2
MAX_FILE_MB=10
MAX_PDF_PAGES=10
MAX_IMAGE_PIXELS=20000000
ANSWER_MAX_CHARS=10000
SESSION_TTL_HOURS=72

# ---------- 并发可靠性（开发说明 §9） ----------
# 会话锁租约与抢锁等待：租约要短于最坏模型耗时，靠自动续期兜住
SESSION_LOCK_TTL_MS=30000
SESSION_LOCK_WAIT_MS=800
# Redis 幂等缓存保留时长（正式依据在 PostgreSQL，缓存丢了不影响正确性）
IDEMPOTENCY_TTL_HOURS=6

# ---------- 匿名访客与跨域（开发说明 §11） ----------
# Redis key 前缀里的环境标识：dev / test / prod 共用一个实例时靠它隔离
APP_ENV=dev
VISITOR_COOKIE_NAME=aiiv_visitor
# 生产 HTTPS 必须设 1（Cookie 加 Secure）；本地 http 调试设 0
COOKIE_SECURE=0
# 本地前端开发服（5173）与后端（8000）不同源时填在这里，逗号分隔
ALLOWED_ORIGINS=http://localhost:5173

# ============================================================
# 兼容说明：旧原型使用的 OPENAI_API_KEY / OPENAI_BASE_URL / MODEL_NAME
# 三个键仍然有效（TEXT_* 未配置时自动回退），但新代码请统一用 TEXT_*。
# ============================================================
